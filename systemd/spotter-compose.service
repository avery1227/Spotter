# Run the Docker Compose stack under systemd.
#
#   sudo cp systemd/spotter-compose.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now spotter-compose

[Unit]
Description=Spotter AIS/ADS-B camera overlay (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory=/opt/spotter
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose up -d --build
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
