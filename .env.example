# Copy to .env and fill in. Used by docker-compose.yml.

# Where to publish the composited stream.
#   YouTube:   rtmp://a.rtmp.youtube.com/live2/xxxx-xxxx-xxxx-xxxx
#   MediaMTX:  rtmp://mediamtx:1935/live/spotter   (the bundled profile)
RTMP_URL=rtmp://mediamtx:1935/live/spotter

# aisstream.io key, only needed if you have no local AIS receiver.
AISSTREAM_API_KEY=

# Timezone for the on-screen clock.
TZ=America/New_York
